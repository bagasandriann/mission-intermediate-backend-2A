{
  "info": {
    "_postman_id": "a8c8c4e8-edu-course-node-mysql",
    "name": "EduCourse API - Intermediate Backend",
    "description": "Postman collection for the EduCourse Node.js + Express + MySQL assignment. Covers DB health check and CRUD endpoints for courses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "courseId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ]
            }
          }
        },
        {
          "name": "Database Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "db"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Course",
      "item": [
        {
          "name": "GET - All Courses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains data array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/course",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "course"
              ]
            }
          }
        },
        {
          "name": "GET - Course By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Course exists', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/course/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "course",
                "{{courseId}}"
              ]
            }
          }
        },
        {
          "name": "POST - Create Course",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Course was created', function () {",
                  "    pm.expect(json.data).to.have.property('id');",
                  "});",
                  "",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('courseId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"tutor_id\": 1,\n  \"title\": \"REST API with Node.js\",\n  \"price\": 180000,\n  \"level\": \"BEGINNER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/course",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "course"
              ]
            }
          }
        },
        {
          "name": "PATCH - Update Course",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Course was updated', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 200000,\n  \"level\": \"INTERMEDIATE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/course/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "course",
                "{{courseId}}"
              ]
            }
          }
        },
        {
          "name": "DELETE - Course",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Delete succeeded', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.eql('Course deleted successfully');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/course/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "course",
                "{{courseId}}"
              ]
            }
          }
        },
        {
          "name": "GET - Non Existing Course (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/course/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "course",
                "999999"
              ]
            }
          }
        }
      ]
    }
  ]
}